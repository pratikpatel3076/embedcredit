# ── Vantage Credit ────────────────────────────────────────────────
# Copy this file to server/.env for local (non-Docker) development.
# When running under docker-compose, the compose file injects these.

# MongoDB connection string (Docker overrides to mongodb://mongo:27017/vantage_credit)
MONGODB_URI=mongodb://localhost:27017/vantage_credit

# JWT signing secret — change in production
JWT_SECRET=change_this_in_production

# API port
PORT=5000

# Allowed CORS origin for the React client
CLIENT_URL=http://localhost:3000

# First Loss Default Guarantee cap as a fraction of a lender's portfolio (RBI DL 2022)
FLDG_CAP=0.05

NODE_ENV=development

# ── Seeded users (one per role) ──────────────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_DLA_USERNAME=dla1
SEED_DLA_PASSWORD=Dla@123
SEED_LENDER_USERNAME=lender1
SEED_LENDER_PASSWORD=Lender@123

# Lender account is bound to this lender product id (L003 = HDFC Bank in seed data)
SEED_LENDER_LENDER_ID=L003

# Whether to auto-seed demo data on server boot (false disables)
SEED_ON_BOOT=true
